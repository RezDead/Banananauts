# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Ignore all binaries by default
Binaries/*
Plugins/*/Binaries/*

# Allow the folder structure so Git can traverse into it
!Binaries/*/
!Plugins/*/Binaries/*/

# Allow module descriptor files
!Binaries/*/*.modules
!Plugins/*/*/Binaries/*/*.modules

# Allow Editor binaries for your platforms
!Binaries/Win64/UnrealEditor*.dll
!Plugins/*/Binaries/Win64/UnrealEditor*.dll
!Binaries/Mac/UnrealEditor*.dylib
!Plugins/*/Binaries/Mac/UnrealEditor*.dylib

# Keep intermediate debug files and patches IGNORED
Binaries/*/*.patch_*
Binaries/*/*.pdb
Plugins/*/Binaries/*/*.patch_*
Plugins/*/Binaries/*/*.pdb

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Ignore JetBrains Rider project settings
.idea/